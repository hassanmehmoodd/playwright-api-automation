# Public sandbox endpoints and demo accounts published by each API.
# Copy to .env to override. The same values are the framework defaults,
# so a local run works without this file. Do not put real secrets here.

BOOKER_BASE_URL=https://restful-booker.herokuapp.com
BOOKER_USERNAME=admin
BOOKER_PASSWORD=password123

DUMMYJSON_BASE_URL=https://dummyjson.com
DUMMYJSON_USERNAME=emilys
DUMMYJSON_PASSWORD=emilyspass

JSONPLACEHOLDER_BASE_URL=https://jsonplaceholder.typicode.com
